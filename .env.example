# Copie este arquivo para ".env" e preencha com as 3 Unseal Keys reais
# geradas pelo "vault operator init" (secao 3.1 do README.md).
# O ".env" NUNCA deve ser commitado (ja esta no .gitignore).

VAULT_UNSEAL_KEY_1="COLE_AQUI_A_CHAVE_1"
VAULT_UNSEAL_KEY_2="COLE_AQUI_A_CHAVE_2"
VAULT_UNSEAL_KEY_3="COLE_AQUI_A_CHAVE_3"
